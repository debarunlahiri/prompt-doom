APP_ENV=local
APP_URL=http://192.168.0.158:8080/prompt-doom/api
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prompt_doom
DB_USERNAME=root
DB_PASSWORD=
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAX_UPLOAD_MB=10

# Optional CLI seeding. The browser setup at /admin/setup.php is preferred.
INITIAL_ADMIN_NAME="Prompt Doom Admin"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
